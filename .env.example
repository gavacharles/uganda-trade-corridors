# Copy to .env (same folder) and paste your keys. .env is private: never publish it.
# TomTom: https://developer.tomtom.com  -> Dashboard -> Keys
# HERE:   https://platform.here.com     -> Access Manager -> Apps -> API keys
TOMTOM_API_KEY=
HERE_API_KEY=
# Optional: request budgets if your plans differ from the free tiers
# TOMTOM_DAILY_REQUESTS=2400
# HERE_MONTHLY_REQUESTS=25000
# Mapillary: https://www.mapillary.com/dashboard/developers -> Register an application -> Client Token (MLY|...)
MAPILLARY_TOKEN=
# Google Earth Engine: Cloud project ID registered for Earth Engine (noncommercial)
EE_PROJECT=
